# ==============================================================================
# Namlatic Hotel Owner Portal – Backend Environment Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit real .env files containing actual passwords or credentials to Git.
# - This template contains placeholder values only for development and documentation.
# ==============================================================================

# Server Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port & Binding Host
# Render requires binding to 0.0.0.0. Render dynamically assigns PORT (e.g. 10000).
PORT=5000
HOST=0.0.0.0

# Allowed CORS Origins (Comma-separated list of exact authorized origins)
# In development, standard localhost ports (5173, 4173) are supported automatically.
# In production, wildcards (*) are forbidden and all entries must be explicit URLs.
# Example: https://namlatic-hotel.vercel.app,https://preview-deploy.vercel.app
CORS_ORIGIN=http://localhost:5173

# Reverse Proxy Trust Configuration (Render Reverse Proxy Topology)
# Setting TRUST_PROXY=1 assumes a single-hop Render reverse proxy topology. Express trusts
# exactly 1 upstream hop, deriving client IP from X-Forwarded-For while preventing client-injected
# IP spoofing. Post-deployment, actual client IP extraction must be verified using req.ip. Any
# temporary diagnostic route used for verification must be removed immediately after testing.
# WARNING: Never switch to unrestricted 'trust proxy: true'. Local dev defaults to false (no proxy).
TRUST_PROXY=1

# Rate Limiting Configuration (In-Memory Process Store)
# NOTE: The default memory store protects a single instance. In horizontal scaling,
# a shared store (e.g. Redis) must be used.
# IMPORTANT: Rate limiting mitigates brute-force abuse, but is NOT authentication.
# Write operations currently lack owner authentication; establish access control before public release.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_GENERAL_WINDOW_MS=900000

# JSON Request Body Size Limit (Guards against memory denial of service)
BODY_LIMIT=10kb

# ------------------------------------------------------------------------------
# Media Storage Configuration (Phase 5D)
# ------------------------------------------------------------------------------
# MEDIA_STORAGE_DRIVER: 'local' | 'r2'
# - In local development and tests, defaults to 'local' (files saved to server/src/uploads/hotels).
# - In production (Render), STRICTLY REQUIRES 'r2'. Setting 'local' or omitting the driver in
#   production is rejected at startup to prevent silent fallback to ephemeral container disks.
# - IMPORTANT MIGRATION NOTE: Recognizing legacy '/uploads/hotels/...' database references does
#   NOT automatically migrate existing physical image files from local disk to Cloudflare R2.
#   Existing hotel media must be uploaded or repopulated prior to production cloud cutover.
# - TESTING NOTE: Automated test suites verify object storage using an in-memory mock S3 client;
#   no real Cloudflare R2 account or bucket has been provisioned.
MEDIA_STORAGE_DRIVER=local

# Cloudflare R2 Credentials & Bucket Configuration (Required when MEDIA_STORAGE_DRIVER=r2)
# - Endpoint format: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (Region: auto)
# - Security Requirement: Use a bucket-scoped R2 API Token with minimal permissions
#   (Object Read & Write only). Never generate or assign Admin or Account-level tokens.
# - R2_PUBLIC_BASE_URL: The public CDN URL for the bucket (e.g. https://pub-<hash>.r2.dev
#   or custom domain https://assets.namlatic.com). In production, this must use HTTPS and
#   must not contain credentials, query strings, or fragments. Public access must be read-only;
#   never enable public bucket writes or public bucket listing.
# - NEVER put these credentials into frontend code or commit real keys to Git.
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=namlatic-hotel-media
R2_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# OPTION 1: Local Development (Discrete Variables)
# Used for local PostgreSQL running on localhost:5432. SSL is disabled locally.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=namlatic_hotel
DB_USER=your_local_db_user
DB_PASSWORD=your_local_db_password

# OPTION 2: Production / Cloud Database (Unified DATABASE_URL)
# REQUIRED when NODE_ENV=production.
# For Neon Serverless PostgreSQL, copy the connection string from your Neon console.
# Format: postgresql://<user>:<password>@<ep-hostname>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=prefer
#
# WHY SSL IS MANDATORY & CHANNEL BINDING POLICY:
# - SSL/TLS: Neon requires encrypted connections. Without ?sslmode=require, connections
#   over the public internet are rejected. Node-postgres verifies Neon's TLS certificate
#   automatically using Node's trusted root CA store.
#
# - IMPORTANT: CHANNEL BINDING SEMANTICS (pg 8.23.1):
#   Neon console connection strings default to "channel_binding=require".
#   However, node-postgres 8.23.1 only supports opportunistic channel binding
#   (enableChannelBinding: true), which negotiates SCRAM-SHA-256-PLUS when offered
#   by the server, but permits fallback to SCRAM-SHA-256 if the server does not offer it.
#   Because the installed driver cannot guarantee strict enforcement without fallback,
#   the application intentionally fails fast and REJECTS "channel_binding=require" to
#   prevent a false sense of security.
#
#   HOW TO CONFIGURE NEON FOR THIS DRIVER:
#   In your copied Neon connection string, change "channel_binding=require" to
#   "channel_binding=prefer" (or omit channel_binding).
#
#   SECURITY NOTE:
#   "prefer" is a deliberate reduction in enforcement compared with "require", NOT an
#   equivalent substitute. It does not protect against an active MITM attacker who
#   strips SCRAM-SHA-256-PLUS from the server mechanism list.
#
# DATABASE_URL=postgresql://your_neon_user:your_neon_password@your_neon_endpoint.aws.neon.tech/neondb?sslmode=require&channel_binding=prefer

# ------------------------------------------------------------------------------
# Connection Pool Tuning (Optional Conservative Defaults for Render & Neon)
# ------------------------------------------------------------------------------
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000
# DB_POOL_CONN_TIMEOUT=5000

# ------------------------------------------------------------------------------
# Dedicated Integration Test Database (Phase 5F-A2.1.1 & Phase 5F-A2.1.2)
# ------------------------------------------------------------------------------
# TEST_DATABASE_URL:
# - Strictly REQUIRED to run backend integration tests (npm run test:integration).
# - Guarantees 100% test isolation from development and production data.
# - Mandatory Safety Rules enforced by tests/helpers/testDb.js:
#   * Rejected immediately if NODE_ENV=production.
#   * Rejected if pointing to protected databases ('namlatic_hotel', 'postgres', 'production', 'neondb').
#   * Database name MUST exactly match designated test database ('namlatic_hotel_test' or TEST_DB_NAME).
#   * Host MUST be an authorized test host (default: localhost, 127.0.0.1, ::1, or TEST_DB_ALLOWED_HOSTS).
#   * Database role MUST be a dedicated non-superuser test role ('namlatic_test' or TEST_DB_USER).
#   * Normal application user (DB_USER / 'namlatic_app') and superusers ('postgres', 'root', 'admin')
#     are strictly REJECTED to prevent accidental test execution under privileged credentials.
# - Safe record tracking: integration tests track created IDs and clean up only temporary test
#   records (WHERE id = ANY($1)), preventing data loss of real owner records.
# - Dedicated non-superuser role setup:
#   CREATE ROLE namlatic_test WITH LOGIN PASSWORD 'your_secure_test_password' NOSUPERUSER NOCREATEDB NOCREATEROLE;
#   GRANT CONNECT ON DATABASE namlatic_hotel_test TO namlatic_test;
#   REVOKE ALL ON DATABASE namlatic_hotel FROM namlatic_test;
#   -- In database namlatic_hotel_test:
#   GRANT USAGE, CREATE ON SCHEMA public TO namlatic_test;
#   GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO namlatic_test;
#   GRANT ALL PRIVILEGES ON ALL SEQUENCES IN SCHEMA public TO namlatic_test;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL PRIVILEGES ON TABLES TO namlatic_test;
#   ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT ALL PRIVILEGES ON SEQUENCES TO namlatic_test;
#
# TEST_DATABASE_URL=postgresql://namlatic_test:your_secure_test_password@localhost:5432/namlatic_hotel_test
# TEST_DB_NAME=namlatic_hotel_test
# TEST_DB_USER=namlatic_test
# TEST_DB_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# ------------------------------------------------------------------------------
# Authentication & Owner Provisioning (Phase 5F-A2.1 & 5F-A2.1.1)
# ------------------------------------------------------------------------------
# OWNER_EMAIL & OWNER_PASSWORD:
# - Used exclusively by the one-time owner bootstrap CLI (npm run db:bootstrap).
# - NEVER hardcode passwords or commit actual credentials to Git.
# - Validation rules:
#   * Email: trimmed and lowercased automatically.
#   * Password: minimum 12 Unicode code points (Array.from(p).length >= 12),
#     maximum 128 UTF-8 bytes (Buffer.byteLength(p, 'utf8') <= 128).
#   * Immutability: passwords are NEVER trimmed, normalized, lowercased, or mutated.
# - Interactive Execution: If omitted and running in an interactive terminal, the
#   script prompts for masked password input.
# - Administrative Recovery: Use NEW_OWNER_PASSWORD for non-interactive password reset
#   via npm run db:reset-password.
#
# OWNER_EMAIL=owner@namlatic.com
# OWNER_PASSWORD=your_secure_password_min_12_chars
# NEW_OWNER_PASSWORD=your_new_secure_password_min_12_chars

# ------------------------------------------------------------------------------
# Internal Reverse Proxy Authentication & Secret Rotation (Phase 5F-A2.2)
# ------------------------------------------------------------------------------
# BACKEND_PROXY_SECRET:
# - Shared secret header ('x-vercel-proxy-secret') injected by Vercel edge routes
#   to authenticate incoming proxy requests to Render.
# - In production (NODE_ENV=production), strictly REQUIRED and must be at least 32 characters.
# - Uses constant-time comparison (crypto.timingSafeEqual on SHA-256 digests) to prevent
#   timing attacks.
# - Zero-downtime rotation: BACKEND_PROXY_SECRET_OLD allows accepting both the current
#   and previous secret during credential rolling.
# - Health and readiness probes (/api/health, /api/ready) are explicitly exempt to
#   allow orchestrator monitoring without secrets.
#
# BACKEND_PROXY_SECRET=your_cryptographically_random_proxy_secret_min_32_chars
# BACKEND_PROXY_SECRET_OLD=your_previous_proxy_secret_during_rotation
