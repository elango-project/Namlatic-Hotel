server/src/uploads/*
!server/src/uploads/.gitkeep
!server/src/uploads/hotels/
server/src/uploads/hotels/*
!server/src/uploads/hotels/.gitkeep

# Coverage
coverage/

# Vercel deployment artifacts & CLI local state
.vercel/
