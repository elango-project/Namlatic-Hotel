# Dependencies
node_modules/

# Environment files (exclude secrets, allow example templates)
.env
.env.*
!.env.example
!.env.*.example

# Build output
client/dist/
server/dist/

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

