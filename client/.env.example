# ==============================================================================
# Namlatic Hotel Owner Portal – Frontend Environment Configuration Template
# ==============================================================================
# IMPORTANT SECURITY & BUILD ARCHITECTURE NOTICE:
# - Vite embeds all variables prefixed with 'VITE_' into the client-side JavaScript
#   bundle at build time (npm run build).
# - These values become PUBLICLY VISIBLE to any user inspecting page source code
#   or browser network requests.
# - NEVER put sensitive secrets in this file or in any client-side configuration.
#   STRICTLY FORBIDDEN:
#     - DATABASE_URL or database credentials
#     - PostgreSQL passwords
#     - Cloudflare R2 access keys or secret access keys (R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY)
#     - JWT signing secrets or session keys
#     - Private API keys or cloud account credentials
# - All sensitive credentials must remain strictly on the backend server.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API Base URL (Required in production)
# ------------------------------------------------------------------------------
# The fully-qualified URL pointing to the Express backend API endpoints.
# Consumed by client/src/services/api.js for all data requests (hotels, stats).
#
# Local Development: http://localhost:5000/api
# Production (Render Web Service): https://<your-service-name>.onrender.com/api
# Vercel Deployment Note: Configure in Vercel Project Settings > Environment Variables.
#
# PREVIEW DEPLOYMENT SECURITY WARNING:
# Vercel Preview deployments should NOT point to the production database or backend
# while mutating write endpoints (POST, PUT, DELETE) remain unauthenticated.
# Point Preview deployments to a dedicated isolated staging/preview backend.
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 2. Backend Server Origin (Required in production for local/legacy media fallback)
# ------------------------------------------------------------------------------
# The root protocol and hostname of the Express backend server (without the /api path).
# Consumed by getImageUrl() in client/src/services/api.js to resolve relative image
# paths (e.g. legacy /uploads/hotels/<filename>) to absolute URLs.
# Note: Cloudflare R2 images arrive with full CDN URLs and bypass this origin.
#
# Local Development: http://localhost:5000
# Production (Render Web Service): https://<your-service-name>.onrender.com
VITE_API_ORIGIN=http://localhost:5000

# ------------------------------------------------------------------------------
# 3. Application Display Currency Code (Optional)
# ------------------------------------------------------------------------------
# ISO 4217 currency code (e.g. USD, EUR, GBP, AED, INR).
# Consumed by client/src/config/currency.js.
# When unset or left empty, the portal formats amounts using a currency-neutral
# decimal format (e.g., "250.00") rather than silently defaulting to USD.
#
# Default: Currency-neutral decimal format (no symbol)
# Optional Override Example:
# VITE_APP_CURRENCY=USD
